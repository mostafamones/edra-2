NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets. Never expose these with NEXT_PUBLIC_ names.
SEND_SMS_HOOK_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_LANGUAGE=
META_WHATSAPP_GRAPH_API_VERSION=v23.0

# Edge Function only. When true, all auth WhatsApp messages go to this E.164 test number.
# Keep false outside a development Supabase project. The original account phone is still verified.
WHATSAPP_DEVELOPMENT_MODE=false
WHATSAPP_DEVELOPMENT_RECIPIENT_PHONE=

# Optional, short-lived server-only OTP log for one development phone number.
# Use an ISO 8601 UTC expiry and remove both secrets after testing.
EDRA_AUTH_DEV_LOG_PHONE=
EDRA_AUTH_DEV_LOG_UNTIL=

# Local-only credential used by npm run audit:auth. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Public Edra origin used in shared staff invitation links (for example https://app.edra.example).
# Required in production; development uses the lvh.me host family.
EDRA_APP_ORIGIN=http://app.lvh.me:3000
# Server-only. 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored staff invitation links
# so managers can copy them again. Rotating it makes existing pending links uncopyable (they still work).
STAFF_INVITE_LINK_KEY=

# Canonical platform origins: set browser values and matching server values together.
# Development uses one Next server and the existing cloud Supabase project.
# Replace the earlier EDRA_APP_ORIGIN value with http://app.lvh.me:3000 in development.
NEXT_PUBLIC_EDRA_MARKETING_ORIGIN=http://lvh.me:3000
NEXT_PUBLIC_EDRA_APP_ORIGIN=http://app.lvh.me:3000
NEXT_PUBLIC_EDRA_LEARN_ORIGIN=http://learn.lvh.me:3000
EDRA_MARKETING_ORIGIN=http://lvh.me:3000
EDRA_LEARN_ORIGIN=http://learn.lvh.me:3000

# Optional, server-only, development-only staff host alias for a phone-reachable tunnel: one exact
# host[:port] with no scheme or path (for example mones.ddns.net:3000). Ignored when NODE_ENV is production.
EDRA_DEV_TUNNEL_HOST=

# Explicit owned parent domain for shared app/learn cookies. Production requires the
# confirmed owned domain, HTTPS origins, and matching browser/server configuration.
NEXT_PUBLIC_EDRA_COOKIE_DOMAIN=lvh.me
