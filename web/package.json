  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "lint": "eslint",
    "typecheck": "node workers-test/generate-routes.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/db-test.sh",
    "test:edge": "bash scripts/edge-check.sh",
    "test:edge:runtime": "bash scripts/edge-test.sh",
