{
  "name": "edra-instructor",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --lan",
    "ios": "expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release --no-bundler",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release --no-bundler",
    "prebuild": "expo prebuild --clean --no-install",
    "sync:icons": "node src/platform/chrome/icons/sync.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --moduleSuffixes .ios,",
    "test": "node --test 'src/**/*.test.ts'",
    "check": "npm run typecheck && npm test && expo install --check && expo export --platform all --output-dir .export-check --no-minify && rm -rf .export-check",
    "native:check": "node scripts/native-client.mjs check",
    "native:save": "node scripts/native-client.mjs save"
  },
  "dependencies": {
    "@expo/ui": "58.0.29",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@supabase/supabase-js": "2.119.0",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.21",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "58.0.8",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@expo/plist": "0.10.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
